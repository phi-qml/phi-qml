{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Φ‑QML",
  "scopeName": "source.phi",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtin-primitives"
    },
    {
      "include": "#types"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.phi",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.phi",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.phi",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.phi",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.phi",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.phi",
          "match": "\\b(0[xX][0-9a-fA-F]+|\\d+)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.phi",
          "match": "\\b(fn|let|mut|if|else|while|for|in|return|when|until|convergence)\\b"
        },
        {
          "name": "constant.language.boolean.phi",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.phi",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.comparison.phi",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.phi",
          "match": "(\\+|\\-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.phi",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arrow.phi",
          "match": "->"
        },
        {
          "name": "keyword.operator.pipe.phi",
          "match": "\\|>"
        }
      ]
    },
    "builtin-primitives": {
      "patterns": [
        {
          "name": "support.function.builtin.phi",
          "match": "\\b(mod|collapse|phi_score|println|measure|CNOT|H|init_field|init_superposition|apply_qft|apply_diffusion)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.phi",
          "match": "\\b(qubit|field|classical|amplitude|Int|BigInt|Point|Signature)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.phi",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
